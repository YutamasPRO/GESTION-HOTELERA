# Variables de Producción (Render + Aiven)

# Puerto (Render asigna automáticamente)
PORT=3000

# Base de datos Aiven
DB_HOST=xxxxx.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASS=your_password_here
DB_NAME=defaultdb

# SSL para Aiven (generalmente requerido)
DB_SSL=true

# Entorno
NODE_ENV=production
